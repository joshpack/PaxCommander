<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>pxdCommander</RootNamespace>
    <AssemblyName>pxdCommander</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\pxdCommander.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.4.1</Version>
    <!-- The Windows shell parts are guarded at runtime; the analyzer can't see those guards. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- tools/ holds separate projects (the README screenshot renderer). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- The image viewer is its own project (it also ships as a standalone app); clone pxdImageViewer next to this repo. -->
    <ProjectReference Include="..\pxdImageViewer\Core\pxdImageViewer.Core.csproj" />
  </ItemGroup>

  <!-- Native graphics libs ship large debug symbols; keep the install lean. -->
  <Target Name="TrimPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_PruneFiles Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PruneFiles)" />
  </Target>

</Project>
